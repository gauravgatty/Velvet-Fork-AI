# ==========================================
# Velvet Fork Environment Variables
# ==========================================

# Database Configuration (MongoDB Atlas or Local)
# For Atlas Cloud (Production):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/velvet_fork?retryWrites=true&w=majority
# For Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/velvet_fork

# Backend Server Port
PORT=5000

# Optional AI Key (Gemini Concierge)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
